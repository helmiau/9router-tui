# 9Router TUI — Environment
# Copy to .env and fill in

# Base URL of your 9Router instance
# Local: http://localhost:20128
# Tunnel: https://distribute-jimmy-church-audit.trycloudflare.com
# VPS: https://9router.example.com
NINEROUTER_URL=http://localhost:20128

# Dashboard API key (only if requireApiKey=true in 9Router settings)
# Get from Dashboard → Keys or GET /api/keys
NINEROUTER_KEY=

# Optional: dashboard login password (if 9Router has password auth)
NINEROUTER_PASSWORD=
